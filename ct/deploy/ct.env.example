# /etc/opsbot/ct.env のひな形。CT102 上にのみ配置し、CT102 外に出さない（§3.4.2）。
# 実ファイルは chmod 600 / owner opsbot にすること。

# --- Workers ポーリング（アウトバウンドのみ） ---
OPSBOT_WORKERS_BASE_URL=https://opsbot.<your-subdomain>.workers.dev
OPSBOT_CT_SHARED_SECRET=__generate_a_long_random_secret__

# --- ポーリング間隔（任意・§3.4.2） ---
OPSBOT_ACTIVE_INTERVAL_SEC=4
OPSBOT_IDLE_INTERVAL_SEC=45

# --- 監視（§3.4.6） ---
OPSBOT_HEARTBEAT_PATH=/var/lib/node_exporter/textfile_collector/opsbot_ct.prom

# --- Crafty API（Vnet 内直接・§3.4.3。Crafty 4.10.4／v2 API） ---
# 認証はアカウント設定 > API Tokens で発行した非ログインの静的トークンを使う（/auth/login は使わない）。
# BASE_URL は Crafty が動いているホストの内部アドレス（例：https://192.168.100.2:8443）。
OPSBOT_CRAFTY_BASE_URL=https://<crafty-host>:8443
OPSBOT_CRAFTY_CERT_FINGERPRINT_SHA256=
OPSBOT_CRAFTY_API_TOKEN=
# SERVER_ID は Crafty の管理画面のサーバー URL に現れる UUID。
OPSBOT_CRAFTY_SERVER_ID=<crafty-server-uuid>
OPSBOT_MAX_CRAFTY_JOBS=3

# --- 個人開発領マスク画像の保存先（Phase 2・§6.3） ---
OPSBOT_MASKS_DIR=/var/lib/opsbot/masks

# --- Dynmap自動反映（Phase 3・§6.3.4・decisions.md #31・#53・open-items #41） ---
# open-items #41は当初Crafty File Manager APIを優先する方針だったが、読み取りエンドポイントが
# 非公開（公式ドキュメント未記載でGitLab上のソースにのみ存在）であることと、既存実装が
# TLS検証を無条件無効化していた問題（ct/CLAUDE.mdの規約違反）が判明したため、CT104への
# 制限付きSSH方式に切り替えた（phase-3-checklist.md C-5・ct/deploy/dynmap_deploy.sh参照）。
# dynmap_web_relative_dir はCT104配信ディレクトリ内の相対パス
# （例：Dynmapプラグインの配信ディレクトリが <サーバー>/plugins/dynmap/web の場合はそのまま）。
OPSBOT_DYNMAP_WEB_RELATIVE_DIR=plugins/dynmap/web
OPSBOT_DYNMAP_IMAGES_SUBDIR=images/indiv
OPSBOT_DYNMAP_OVERLAY_JS_PATH=js/custom_overlay.js
# CT104へのSSH接続設定。秘密鍵はCT102上で生成し、公開鍵のみをCT104のauthorized_keysに
# 強制コマンド付きで登録する（ct/deploy/dynmap_deploy.sh のセットアップ手順を参照）。
OPSBOT_DYNMAP_SSH_HOST=
OPSBOT_DYNMAP_SSH_PORT=22
OPSBOT_DYNMAP_SSH_USER=opsbot-dynmap
OPSBOT_DYNMAP_SSH_IDENTITY_FILE=/etc/opsbot/dynmap_ssh_id_ed25519
OPSBOT_DYNMAP_SSH_KNOWN_HOSTS_FILE=/etc/opsbot/dynmap_known_hosts
# 上記のセットアップ（CT104側スクリプト配置・authorized_keys登録・known_hosts登録）が
# 済むまではfalseのままにしておく。falseの間はdynmap_syncジョブを受理してもスキップし、
# Dynmapへの反映は行われない（Dynmap反映失敗としてタスクは起票されない。運営は配置
# ディレクトリを手動確認すること）。
OPSBOT_DYNMAP_SYNC_ENABLED=false

# --- Claude Code（LLM層・Phase 6・§7） ---
# Claude Code CLI は別途 `claude login` でログイン済みであること（Pro 利用枠・C-5）。
# opsbot-ct-poller.service を動かすOSユーザー（例：opsbot）自身でログインし、
# セッション認証情報がそのユーザーのホーム配下に保存されていることを確認すること
# （§7.4：認証情報の保管はCT102のみに限定し、Cloudflare Workers側には一切渡さない）。
OPSBOT_ANTHROPIC_CLI_PATH=claude
# CLIの既定モデルに委ねず明示指定する（CLIが解釈するエイリアス／モデルIDそのまま）。
# 空文字にするとCLI既定へ委ねる（後方互換）。
OPSBOT_ANTHROPIC_MODEL=sonnet
OPSBOT_CLAUDE_TIMEOUT_SEC=120
# ルール条文の根拠抜粋（§7.3）に使うディレクトリ。未設定なら該当抜粋なしで動作する
# （必須ではない。ルール条文のMarkdownファイル一式をここに配置すると精度が上がる）。
OPSBOT_RULES_DIR=
