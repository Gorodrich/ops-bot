# /etc/opsbot/deploy.env（CT102 の自動デプロイ設定・opsbot-ct-deploy.sh が読む）
# Webhook URL は秘密情報なので root 所有・0600 で置く（systemd が root で読み込んで
# 環境変数として渡すため、opsbot-deploy ユーザーに読み取り権限は不要）：
#   sudo install -o root -g root -m 0600 deploy.env.example /etc/opsbot/deploy.env
OPSBOT_DEPLOY_REPO_URL=https://github.com/Gorodrich/ops-bot.git
OPSBOT_DEPLOY_BRANCH=deploy
OPSBOT_DEPLOY_DISCORD_WEBHOOK_URL=
